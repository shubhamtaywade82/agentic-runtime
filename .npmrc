# Run the pnpm that is already installed instead of self-switching to the
# packageManager pin. pnpm >= 10 otherwise re-execs nested script pnpm calls
# (e.g. `pnpm api-extractor` inside `pnpm build`) under the pinned version,
# which crashes on Node 20 because pnpm 11 needs Node >= 22.13 (node:sqlite).
manage-package-manager-versions=false
