    "./brain": "./dist/brain/index.js",
    "./hands": "./dist/hands/index.js",
    "./memory": "./dist/memory/index.js",
    "./loop": "./dist/loop/index.js",
    "./dispute": "./dist/dispute/index.js",
    "./sentinel": "./dist/sentinel/index.js",
    "./observability": "./dist/observability/index.js",
