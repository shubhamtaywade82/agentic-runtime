    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "zod": "^3.24"
  },
  "packageManager": "pnpm@11.24.0"
